# ===========================================
# WebDev Pro - .gitignore
# ===========================================

# -------------------------
# OS Generated Files
# -------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*~

# -------------------------
# Editor / IDE
# -------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -------------------------
# Node.js / Dependencies
# -------------------------
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
package-lock.json
yarn.lock

# -------------------------
# Build / Dist
# -------------------------
dist/
build/
.cache/
*.min.js
*.min.css

# -------------------------
# Local Config
# -------------------------
.env
.env.local
.env.*.local
config.local.js

# -------------------------
# Logs
# -------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------
# Testing
# -------------------------
coverage/
.nyc_output/

# ===========================================
# Project Specific - Internal Files
# ===========================================

# Documentation & Planning (Internal Use Only)
# These files are for development reference
# and should NOT be deployed to production
# -------------------------------------------
*.md
!README.md

# Reference files (old design references)
# -------------------------------------------
referensiDesain/
docs/
documentation/
notes/

# Temporary / Debug files
# -------------------------------------------
*.tmp
temp/
tmp/
*.bak
*.backup
*.orig
*.rej

# Temporary / Debug files
# -------------------------------------------
*.tmp
temp/
tmp/
*.bak
*.backup
*.orig
*.rej
